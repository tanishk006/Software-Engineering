# =====================================================================
# Smart Campus Portal — Backend Environment Variables Template
# Copy this file to .env and configure for your environment.
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# =====================================================================

# Node Environment ('development', 'production', 'test')
NODE_ENV=development

# Server Port
PORT=5000

# Client Application Origin (used for CORS policy and OAuth callbacks)
FRONTEND_URL=http://localhost:5173

# Database Connection Settings (MySQL 8.0+ / MariaDB 10.4+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=smart_campus
DB_CONNECTION_LIMIT=10
# Set DB_SSL=true for managed cloud databases (AWS RDS, GCP Cloud SQL, PlanetScale)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# JWT Configuration (Required — server fails fast if missing)
# Generate a cryptographically strong 256-bit+ random secret
JWT_SECRET=your_cryptographically_secure_random_jwt_secret_here
JWT_EXPIRES_IN=24h

# Domain Restriction for Google OAuth and Registrations
# Comma-separated list of allowed institutional domains
ALLOWED_EMAIL_DOMAINS=campus.edu,college.edu

# Google OAuth Credentials (Optional: required for institutional Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
